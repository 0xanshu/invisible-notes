{
  "name": "invisible-notes",
  "version": "1.0.0",
  "description": "Translucent sticky notes that stay invisible to screen sharing and recording.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "author": "Navya Bijoy",
  "license": "MIT",
  "homepage": "https://github.com/navyabijoy/invisible-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/navyabijoy/invisible-notes.git"
  },
  "bugs": {
    "url": "https://github.com/navyabijoy/invisible-notes/issues"
  },
  "keywords": [
    "sticky-notes",
    "notes",
    "electron",
    "screen-sharing",
    "privacy",
    "menubar",
    "overlay"
  ],
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.invisiblenotes.app",
    "productName": "Invisible Notes",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "note.html",
      "note.js"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
